#Crie duas listas: uma para os nomes dos produtos e outra para as quantidades correspondentes
nomep = []
quantp = []
#Pergunte ao usuário quantos produtos deseja cadastrar. Use um for para repetir a leitura de dados (nome do produto e quantidade) até completar o número informado. 


while True:
    print('Cadastro de Produtos')
    print('1 - Adicionar Itens')
    print('2 - Remover Itens')
    print('3 - Listar itens')
    print ('4 - Sair da repetição')

    opcao = input('Digite a opção: ')

    if opcao == '1':
        nome = input ('digite o nome do produto: ')
        quant = int(input ('digite a quantidade de produtos: '))

        if nome in nomep:
            print ('produto ja adicionado')
        else:
            nomep.append(nome)
            quantp.append(quant)
    elif opcao == '2':
        if len(nomep) == 0:
            print ('nao existe nada na lista')
        else:
            nomep.remove(nome)
            print (f'{nome} removido com sucesso')
    elif opcao == '3':
        if len(nomep) == 0:
            print ('nao existe nada na lista')
        else:
            for i in range(len(nomep)):
                print (f'Nome: {nomep[i]} | Quantidade: {quantp[i]}')
    elif opcao == '4':
        print ('saindo do programa...')
        break
    else:
        print ('opção não encontrada')
  
